{
  "name": "iobroker.viessmannapi",
  "version": "2.6.0",
  "description": "Maintained fork of the ioBroker adapter for Viessmann Developer Cloud API",
  "author": {
    "name": "riessfa"
  },
  "homepage": "https://github.com/riessfa/ioBroker.viessmannapi",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "viessmann",
    "vicare",
    "vitoconnect",
    "heating",
    "heat pump"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riessfa/ioBroker.viessmannapi.git"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "axios": "^1.20.0",
    "json-bigint": "^1.0.0"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.3.0",
    "@iobroker/types": "^7.2.5",
    "@types/node": "^22.18.0",
    "chai": "^4.5.0",
    "chai-as-promised": "^7.1.2",
    "mocha": "^12.0.3",
    "sinon-chai": "^3.7.0",
    "typescript": "^6.0.3"
  },
  "main": "main.js",
  "scripts": {
    "test:js": "mocha --config test/mocharc.custom.json \"{!(node_modules|test)/**/*.test.js,*.test.js,test/**/test!(PackageFiles|Startup).js}\"",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:js && npm run test:package",
    "check": "tsc --noEmit -p tsconfig.check.json",
    "lint": "eslint -c eslint.config.mjs .",
    "translate": "translate-adapter",
    "release": "release-script"
  },
  "bugs": {
    "url": "https://github.com/riessfa/ioBroker.viessmannapi/issues"
  },
  "readmeFilename": "README.md",
  "engines": {
    "node": ">=22"
  },
  "contributors": [
    {
      "name": "TA2k",
      "email": "tombox2020@gmail.com"
    }
  ],
  "files": [
    "admin/",
    "lib/*.js",
    "io-package.json",
    "LICENSE",
    "main.js"
  ],
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "esbuild": "^0.25.0",
    "diff": "^8.0.3"
  }
}
